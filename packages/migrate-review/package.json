{
  "name": "@kappan/migrate-review",
  "version": "0.3.2",
  "type": "module",
  "description": "Migrate a Re:VIEW project to a Kappan project (.re files, config.yml, catalog.yml, images)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@kappan/core": "workspace:*",
    "@kappan/plugin-review-compat": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "keywords": [
    "kappan",
    "review",
    "migration"
  ],
  "author": "isozu",
  "homepage": "https://github.com/isozu/kappan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isozu/kappan.git",
    "directory": "packages/migrate-review"
  },
  "bugs": {
    "url": "https://github.com/isozu/kappan/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
